---
// Fallback for `npm run dev` / preview. In production, public/_redirects sends "/" to "/fr/".
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0; url=/fr/" />
    <link rel="canonical" href={new URL('/fr/', Astro.site)} />
    <link rel="alternate" hreflang="fr" href={new URL('/fr/', Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/fr/', Astro.site)} />
    <title>Bchhal ?</title>
  </head>
  <body><a href="/fr/">Français</a> · <a href="/en/">English</a></body>
</html>
