---
import { type Lang, t } from '@/i18n/ui';
import type { Faq } from '@/lib/seo';

interface Props { lang: Lang; faq: Faq }
const { lang, faq } = Astro.props;
---

{
  faq.length > 0 && (
    <section class="mt-8">
      <h2 class="mb-3 text-2xl font-semibold">{t(lang, 'common.faq')}</h2>
      {faq.map((f) => (
        <details class="bc-card mb-2 p-4">
          <summary class="cursor-pointer font-medium marker:text-brass">{f.q[lang]}</summary>
          <p class="mt-2 text-ink-muted">{f.a[lang]}</p>
        </details>
      ))}
    </section>
  )
}
