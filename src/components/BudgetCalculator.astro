---
/**
 * Simple Morocco budget calculator (vanilla JS, ~2 KB).
 * Values come from src/data/budget.json and are DEMO values until field surveys.
 * Reads ?city=<id> so item pages can link to the budget of their city.
 */
import { type Lang } from '@/i18n/ui';
import budget from '@/data/budget.json';

interface Props { lang: Lang }
const { lang } = Astro.props;

const L = {
  fr: {
    city: 'Ville', days: 'Nombre de jours', travelers: 'Voyageurs', style: 'Style de voyage',
    extras: 'Extras', total: 'Total estimé', perPerson: 'par personne', perDay: 'par jour et par personne',
    demo: 'Valeurs de démonstration, pas encore vérifiées sur le terrain. Ne les utilisez pas comme référence.',
    rate: 'Taux de change indicatif',
  },
  en: {
    city: 'City', days: 'Number of days', travelers: 'Travellers', style: 'Travel style',
    extras: 'Extras', total: 'Estimated total', perPerson: 'per person', perDay: 'per day per person',
    demo: 'Demo values, not yet verified on the ground. Do not rely on them yet.',
    rate: 'Indicative exchange rate',
  },
}[lang];
---

<form id="budget-calc" class="grid gap-4 rounded-xl bg-white p-4 shadow-sm" data-budget={JSON.stringify(budget)} data-lang={lang}>
  {!budget.verified && <p class="rounded-lg bg-amber-100 p-3 text-sm">⚠️ {L.demo}</p>}

  <div class="grid gap-4 sm:grid-cols-3">
    <label class="grid gap-1 text-sm font-medium">
      {L.city}
      <select name="city" class="rounded border border-ink/20 p-2">
        {Object.entries(budget.cities).map(([id, c]) => <option value={id}>{c[lang]}</option>)}
      </select>
    </label>
    <label class="grid gap-1 text-sm font-medium">
      {L.days}
      <input type="number" name="days" min="1" max="60" value="7" class="rounded border border-ink/20 p-2" />
    </label>
    <label class="grid gap-1 text-sm font-medium">
      {L.travelers}
      <input type="number" name="travelers" min="1" max="20" value="2" class="rounded border border-ink/20 p-2" />
    </label>
  </div>

  <fieldset class="grid gap-2">
    <legend class="mb-1 text-sm font-medium">{L.style}</legend>
    <div class="flex flex-wrap gap-3">
      {
        Object.entries(budget.styles).map(([id, s], i) => (
          <label class="flex items-center gap-1">
            <input type="radio" name="style" value={id} checked={i === 1} /> {s.label[lang]}
          </label>
        ))
      }
    </div>
  </fieldset>

  <fieldset class="grid gap-2">
    <legend class="mb-1 text-sm font-medium">{L.extras}</legend>
    <div class="flex flex-wrap gap-3">
      {
        Object.entries(budget.extras).map(([id, e]) => (
          <label class="flex items-center gap-1">
            <input type="checkbox" name="extras" value={id} /> {e[lang]}
          </label>
        ))
      }
    </div>
  </fieldset>

  <output name="result" class="block rounded-lg bg-sand p-4" aria-live="polite">
    <p class="text-sm">{L.total}</p>
    <p class="text-3xl font-bold"><span data-total>—</span> MAD <span class="text-lg font-normal">(≈ <span data-eur>—</span> €)</span></p>
    <p class="text-sm"><span data-pp>—</span> MAD {L.perPerson}</p>
    <ul data-lines class="mt-3 grid gap-1 text-sm"></ul>
    <p class="mt-2 text-xs text-ink/60">{L.rate} : 1 € ≈ {budget.eurToMad} MAD</p>
  </output>
</form>

<script>
  type Budget = {
    eurToMad: number;
    cities: Record<string, { factor: number }>;
    styles: Record<string, { perDay: Record<string, number> }>;
    extras: Record<string, Record<string, number | string>>;
    categories: Record<string, Record<string, string>>;
  };

  const form = document.querySelector<HTMLFormElement>('#budget-calc');
  if (form) {
    const data = JSON.parse(form.dataset.budget!) as Budget;
    const lang = form.dataset.lang!;
    const fmt = new Intl.NumberFormat(lang === 'fr' ? 'fr-FR' : 'en-GB', { maximumFractionDigits: 0 });
    const $ = (sel: string) => form.querySelector<HTMLElement>(sel)!;

    const cityParam = new URLSearchParams(location.search).get('city');
    if (cityParam && cityParam in data.cities) (form.elements.namedItem('city') as HTMLSelectElement).value = cityParam;

    const compute = () => {
      const fd = new FormData(form);
      const days = Math.max(1, Number(fd.get('days')) || 1);
      const people = Math.max(1, Number(fd.get('travelers')) || 1);
      const style = String(fd.get('style'));
      const factor = data.cities[String(fd.get('city'))]?.factor ?? 1;
      const lines: [string, number][] = Object.entries(data.styles[style].perDay).map(([k, v]) => [
        data.categories[k][lang],
        v * days * factor,
      ]);
      for (const id of fd.getAll('extras')) {
        const e = data.extras[String(id)];
        lines.push([String(e[lang]), Number(e[style]) * factor]);
      }
      const pp = lines.reduce((sum, [, v]) => sum + v, 0);
      const total = pp * people;
      $('[data-total]').textContent = fmt.format(total);
      $('[data-eur]').textContent = fmt.format(total / data.eurToMad);
      $('[data-pp]').textContent = fmt.format(pp);
      $('[data-lines]').replaceChildren(
        ...lines.map(([label, v]) => {
          const li = document.createElement('li');
          li.textContent = `${label} : ${fmt.format(v)} MAD`;
          return li;
        }),
      );
    };
    form.addEventListener('input', compute);
    form.addEventListener('submit', (e) => e.preventDefault());
    compute();
  }
</script>
