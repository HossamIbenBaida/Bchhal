---
/**
 * Plays a Darija recording (when FEATURES.audio is on) and offers a full-screen "show the seller" mode.
 * Audio files live in Cloudflare R2 (PUBLIC_AUDIO_BASE) or /public/audio in dev.
 * Only a few lines of vanilla JS, no framework needed.
 */
import { type Lang, t } from '@/i18n/ui';
import { FEATURES } from '@/config';

interface Props {
  lang: Lang;
  latin: string;
  arabic: string;
  file?: string;
  recorded: boolean;
}
const { lang, latin, arabic, file, recorded } = Astro.props;
const base = import.meta.env.PUBLIC_AUDIO_BASE || '/audio/';
const src = FEATURES.audio && file && recorded ? `${base.replace(/\/?$/, '/')}${file}` : null;
---

<div class="audio-player flex flex-wrap items-center gap-3">
  {
    src ? (
      <>
        <audio preload="none" src={src} />
        <button type="button" data-play class="bc-play" aria-label={t(lang, 'darija.listen')}>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11l9-5.5z" /></svg>
        </button>
      </>
    ) : (
      FEATURES.audio && <p class="text-sm italic text-ink-muted">{t(lang, 'darija.audioSoon')}</p>
    )
  }
  <button type="button" data-show class="bc-btn bc-btn--night">
    {t(lang, 'darija.show')}
  </button>

  <dialog data-screen class="bc-show m-0 h-full max-h-none w-full max-w-none p-6 backdrop:bg-night">
    <div class="flex h-full flex-col items-center justify-center gap-6 text-center">
      <p lang="ar" dir="rtl" class="bc-show__ar">{arabic}</p>
      <p class="bc-show__lat">{latin}</p>
      <form method="dialog">
        <button class="bc-btn bc-btn--ghost" style="color: var(--on-night)">{t(lang, 'darija.close')}</button>
      </form>
    </div>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.audio-player').forEach((root) => {
    const audio = root.querySelector('audio');
    root.querySelector('[data-play]')?.addEventListener('click', () => {
      if (!audio) return;
      audio.currentTime = 0;
      void audio.play();
    });
    const dialog = root.querySelector<HTMLDialogElement>('[data-screen]');
    root.querySelector('[data-show]')?.addEventListener('click', () => dialog?.showModal());
  });
</script>
