---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AudioPlayer from '@/components/AudioPlayer.astro';
import Faq from '@/components/Faq.astro';
import UpdatedAt from '@/components/UpdatedAt.astro';
import { getEntries } from 'astro:content';
import { type Lang, t, path, otherLang } from '@/i18n/ui';
import { faqLd } from '@/lib/seo';
import type { Phrase } from '@/lib/content';

interface Props { lang: Lang; entry: Phrase }
const { lang, entry } = Astro.props;
const d = entry.data;
const other = otherLang(lang);
const alternates = { [lang]: path(lang, 'darija', d.slug[lang]), [other]: path(other, 'darija', d.slug[other]) } as Record<Lang, string>;

const objets = await getEntries(d.objets.map((id) => ({ collection: 'objets' as const, id })));
const related = await getEntries(d.related.map((id) => ({ collection: 'phrases' as const, id })));

const title =
  lang === 'fr'
    ? `« ${d.latin} » : dire « ${d.meaning.fr.toLowerCase()} » en darija`
    : `"${d.latin}": how to say "${d.meaning.en.toLowerCase()}" in Darija`;
---

<BaseLayout
  {lang}
  {title}
  description={d.description[lang]}
  {alternates}
  breadcrumbs={[
    { name: t(lang, 'nav.home'), href: path(lang) },
    { name: t(lang, 'nav.darija'), href: path(lang, 'darija') },
    { name: d.latin, href: alternates[lang] },
  ]}
  jsonLd={[faqLd(d.faq, lang)]}
>
  <article>
    <h1 class="text-3xl font-bold sm:text-4xl">{title}</h1>
    <UpdatedAt {lang} date={d.updated} />

    <div class="bc-phrase mx-auto mt-8 max-w-sm">
      <p lang="ar" dir="rtl" class="bc-phrase__ar">{d.arabic}</p>
      <p class="bc-phrase__lat">{d.latin}</p>
      <p class="bc-phrase__mean">{t(lang, 'darija.meaning')} : {d.meaning[lang]}</p>
      <div class="bc-phrase__actions">
        <AudioPlayer {lang} latin={d.latin} arabic={d.arabic} file={d.audio} recorded={d.audioRecorded} />
      </div>
    </div>

    <section class="mt-6">
      <h2 class="mb-2 text-2xl font-semibold">{t(lang, 'darija.when')}</h2>
      <p>{d.usage[lang]}</p>
    </section>

    {
      (objets.length > 0 || related.length > 0) && (
        <section class="mt-6">
          <h2 class="mb-3 text-2xl font-semibold">{t(lang, 'common.related')}</h2>
          <ul class="grid gap-2">
            {objets.filter(Boolean).map((o) => (
              <li><a href={path(lang, 'prices', o.data.slug[lang])} class="text-zellige underline">{t(lang, 'nav.prices')} : {o.data.name[lang]}</a></li>
            ))}
            {related.filter(Boolean).map((p) => (
              <li><a href={path(lang, 'darija', p.data.slug[lang])} class="text-zellige underline">« {p.data.latin} »</a></li>
            ))}
          </ul>
        </section>
      )
    }

    <Faq {lang} faq={d.faq} />
  </article>
</BaseLayout>
