---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { type Lang, t, path } from '@/i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const items = await getCollection('phrases');
const situations = {
  souk: { fr: 'Au souk', en: 'In the souk' },
  taxi: { fr: 'En taxi', en: 'In a taxi' },
  restaurant: { fr: 'Au restaurant', en: 'At the restaurant' },
  politesse: { fr: 'Politesse', en: 'Politeness' },
} as const;
const title = lang === 'fr' ? 'Darija de poche : les phrases utiles au Maroc' : 'Pocket Darija: useful phrases for Morocco';
const description =
  lang === 'fr'
    ? 'Les phrases de darija marocaine utiles en voyage, par situation, en écriture latine et arabe, avec audio.'
    : 'Useful Moroccan Darija phrases for travellers, by situation, in Latin and Arabic script, with audio.';
---

<BaseLayout
  {lang} {title} {description}
  alternates={{ fr: path('fr', 'darija'), en: path('en', 'darija') }}
  breadcrumbs={[{ name: t(lang, 'nav.home'), href: path(lang) }, { name: t(lang, 'nav.darija'), href: path(lang, 'darija') }]}
>
  <h1 class="text-3xl font-bold">{title}</h1>
  {
    (Object.keys(situations) as (keyof typeof situations)[]).map((s) => {
      const list = items.filter((p) => p.data.situation === s);
      return (
        list.length > 0 && (
          <section class="mt-6">
            <h2 class="mb-3 text-xl font-bold">{situations[s][lang]}</h2>
            <ul class="grid gap-3 sm:grid-cols-2">
              {list.map((p) => (
                <li>
                  <a href={path(lang, 'darija', p.data.slug[lang])} class="flex items-center justify-between rounded-xl bg-white p-4 shadow-sm hover:shadow-md">
                    <span><span class="font-bold">{p.data.latin}</span> <span class="text-sm text-ink/70">{p.data.meaning[lang]}</span></span>
                    <span lang="ar" dir="rtl" class="font-arabic text-2xl">{p.data.arabic}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      );
    })
  }
</BaseLayout>
