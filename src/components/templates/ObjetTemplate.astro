---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Faq from '@/components/Faq.astro';
import UpdatedAt from '@/components/UpdatedAt.astro';
import { getEntries } from 'astro:content';
import { type Lang, t, path, otherLang } from '@/i18n/ui';
import { faqLd } from '@/lib/seo';
import type { Objet } from '@/lib/content';
import budget from '@/data/budget.json';

interface Props { lang: Lang; entry: Objet }
const { lang, entry } = Astro.props;
const d = entry.data;
const other = otherLang(lang);
const alternates = { [lang]: path(lang, 'prices', d.slug[lang]), [other]: path(other, 'prices', d.slug[other]) } as Record<Lang, string>;

const phrases = await getEntries(d.phrases.map((id) => ({ collection: 'phrases' as const, id })));
const fmt = new Intl.NumberFormat(lang === 'fr' ? 'fr-FR' : 'en-GB');

// Product structured data only for verified prices: we never publish unverified ranges to Google.
const verified = d.prices.filter((p) => p.verified);
const productLd = verified.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: d.name[lang],
      description: d.description[lang],
      offers: {
        '@type': 'AggregateOffer',
        priceCurrency: 'MAD',
        lowPrice: Math.min(...verified.map((p) => p.min)),
        highPrice: Math.max(...verified.map((p) => p.max)),
        offerCount: verified.length,
      },
    }
  : null;

const title = lang === 'fr' ? `Prix d'un ${d.name.fr.toLowerCase()} au souk de Marrakech` : `${d.name.en} price in the Marrakech souk`;
---

<BaseLayout
  {lang}
  {title}
  description={d.description[lang]}
  {alternates}
  breadcrumbs={[
    { name: t(lang, 'nav.home'), href: path(lang) },
    { name: t(lang, 'nav.prices'), href: path(lang, 'prices') },
    { name: d.name[lang], href: alternates[lang] },
  ]}
  jsonLd={[productLd, faqLd(d.faq, lang)]}
>
  <article>
    <h1 class="text-3xl font-bold">{title}</h1>
    <UpdatedAt {lang} date={d.updated} />
    <p class="mt-4 text-lg">{d.intro[lang]}</p>

    <section class="mt-6">
      <h2 class="mb-3 text-xl font-bold">{t(lang, 'prices.range')}</h2>
      <div class="overflow-x-auto">
        <table class="w-full rounded-lg bg-white text-left shadow-sm">
          <thead class="text-sm text-ink/70">
            <tr><th class="p-3">{t(lang, 'prices.quality')}</th><th class="p-3">{t(lang, 'prices.city')}</th><th class="p-3">MAD</th></tr>
          </thead>
          <tbody>
            {
              d.prices.map((p) => (
                <tr class="border-t border-ink/10">
                  <td class="p-3">{p.quality[lang]}</td>
                  <td class="p-3">{p.city}</td>
                  <td class="p-3 font-semibold">
                    {fmt.format(p.min)} – {fmt.format(p.max)} <span class="font-normal text-sm">{p.unit[lang]}</span>
                    {!p.verified && <span class="ml-1 rounded bg-amber-100 px-1 text-xs">?</span>}
                    {p.source && <span class="block text-xs font-normal text-ink/60">{t(lang, 'common.source')} : {p.source}</span>}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      {d.prices.some((p) => !p.verified) && <p class="mt-2 rounded-lg bg-amber-100 p-3 text-sm">⚠️ {t(lang, 'common.unverified')}</p>}
    </section>

    {
      d.tips.length > 0 && (
        <section class="mt-6">
          <h2 class="mb-3 text-xl font-bold">{t(lang, 'prices.tips')}</h2>
          <ul class="list-disc space-y-1 pl-5">{d.tips.map((tip) => <li>{tip[lang]}</li>)}</ul>
        </section>
      )
    }

    <section class="mt-6">
      <h2 class="mb-3 text-xl font-bold">{t(lang, 'common.related')}</h2>
      <ul class="grid gap-2">
        {
          phrases.filter(Boolean).map((p) => (
            <li>
              <a href={path(lang, 'darija', p.data.slug[lang])} class="text-terracotta underline">
                {t(lang, 'prices.phrase')} : « {p.data.latin} » ({p.data.meaning[lang]})
              </a>
            </li>
          ))
        }
        {
          d.cities.filter((c) => c in budget.cities).map((c) => (
            <li>
              <a href={`${path(lang, 'budget')}?city=${c}`} class="text-terracotta underline">
                {t(lang, 'budget.title')} : {budget.cities[c as keyof typeof budget.cities][lang]}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <Faq {lang} faq={d.faq} />
  </article>
</BaseLayout>
