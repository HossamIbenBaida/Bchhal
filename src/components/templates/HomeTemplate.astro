---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { type Lang, t, path } from '@/i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = {
  fr: {
    title: 'Compagnon de voyage au Maroc : juste prix, budget et darija',
    description: 'Préparez votre budget voyage au Maroc, connaissez le juste prix au souk et dites les bons mots en darija.',
    h1: 'Bchhal ? Le juste prix, le bon budget, les bons mots.',
    cards: [
      { s: 'budget', h: 'Avant : votre budget', p: 'Riad, hammam, désert, taxis, pourboires : estimez votre voyage.' },
      { s: 'prices', h: 'Au souk : le juste prix', p: 'Fourchettes par objet, par ville et par qualité.' },
      { s: 'darija', h: 'Partout : la darija de poche', p: 'Les phrases utiles, en darija latine et arabe, à montrer en grand sur l’écran.' },
    ],
  },
  en: {
    title: 'Morocco travel companion: fair prices, budget and Darija',
    description: 'Plan your Morocco travel budget, know the fair price in the souk and speak a few words of Darija.',
    h1: 'Bchhal? The fair price, the right budget, the right words.',
    cards: [
      { s: 'budget', h: 'Before: your budget', p: 'Riad, hammam, desert, taxis, tips: estimate your trip.' },
      { s: 'prices', h: 'In the souk: fair prices', p: 'Ranges per item, per city and per quality.' },
      { s: 'darija', h: 'Everywhere: pocket Darija', p: 'Useful phrases in Latin and Arabic script, with a big-screen mode to show sellers.' },
    ],
  },
}[lang];
const alternates = { fr: path('fr'), en: path('en') };
const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: t(lang, 'site.name'),
  url: new URL(path(lang), Astro.site).href,
  inLanguage: lang,
};
---

<BaseLayout {lang} title={copy.title} description={copy.description} {alternates} jsonLd={[siteLd]}>
  <h1 class="text-3xl font-bold sm:text-4xl">{copy.h1}</h1>
  <p class="mt-3 text-lg">{t(lang, 'site.tagline')}</p>
  <div class="mt-8 grid gap-4 sm:grid-cols-3">
    {
      copy.cards.map((c) => (
        <a href={path(lang, c.s as 'budget' | 'prices' | 'darija')} class="block rounded-xl bg-white p-5 shadow-sm hover:shadow-md">
          <h2 class="text-lg font-bold text-terracotta">{c.h}</h2>
          <p class="mt-1 text-sm">{c.p}</p>
        </a>
      ))
    }
  </div>
</BaseLayout>
